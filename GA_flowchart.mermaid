%%{init: {'flowchart': {'nodeSpacing': 60, 'rankSpacing': 80}}}%%
flowchart LR

    A([Start])

    A --> B["Generate<br/>Initial Population"]
    B --> C["Evaluate Fitness<br/>Distance Cost + Facility Cost + Unused Stop Penalty"]

    C --> D{"Stopping<br/>Criterion<br/>Reached?"}

    D -- No --> E["Tournament Selection<br/>Choose Best of 5"]

    E --> F["Uniform Crossover<br/>Create Offspring"]
    F --> G["Mutation<br/>Rate = 0.3"]

    G --> H{"At Least One<br/>Stop Open?"}

    H -- No --> I["Randomly Open<br/>One Stop"]
    H -- Yes --> J["Evaluate Offspring<br/>Fitness"]

    I --> J

    J --> K["Create<br/>Next<br/>Generation"]
    K --> C

    D -- Yes --> L([Best Stop Configuration])